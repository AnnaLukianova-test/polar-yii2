# Application
APP_PORT=8082
COOKIE_VALIDATION_KEY=change_me_to_a_random_string

# Rate limiting (login / signup)
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW=900

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=polar_yii
DB_USER=polar
DB_PASSWORD=change_me
POSTGRES_HOST_PORT=5433

# Polar AccessLink
POLAR_CLIENT_ID=your_client_id
POLAR_CLIENT_SECRET=your_client_secret
POLAR_TOKEN_ENCRYPTION_KEY=change_me_to_a_random_string
POLAR_REDIRECT_URI=http://localhost:8082/polar/callback
POLAR_AUTH_URL=https://auth.polar.com/oauth/authorize
POLAR_TOKEN_URL=https://auth.polar.com/oauth/token
POLAR_API_BASE_URL=https://www.polaraccesslink.com
